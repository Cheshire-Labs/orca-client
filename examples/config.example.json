{
  "client_id": "lab-workstation-1",
  "site": "boston",
  "lab": "molbio",
  "workcell": null,
  "platform": {
    "url": "wss://your-deployment.example.com/ws/devices",
    "api_key": "${ORCA_CLIENT_API_KEY}",
    "heartbeat_interval": 30.0,
    "reconnect_backoff": [1, 2, 4, 8, 16, 30]
  },
  "devices": [
    {
      "type": "shaker",
      "name": "Inheco Thermoshake",
      "driver": {
        "type": "plr",
        "backend": "InhecoThermoShake",
        "connection": {
          "type": "serial",
          "port": "COM3",
          "baudrate": 9600
        }
      }
    },
    {
      "type": "centrifuge",
      "name": "Agilent VS6000",
      "driver": {
        "type": "sim"
      }
    },
    {
      "type": "transporter",
      "name": "PreciseFlex 400",
      "driver": {
        "type": "plr",
        "backend": "PreciseFlex",
        "connection": {
          "type": "tcp",
          "host": "192.168.1.100",
          "tcp_port": 10100
        },
        "arm": {
          "gripper_z_offset": 0.0,
          "closed_gripper_position": 75.5
        }
      }
    }
  ]
}
